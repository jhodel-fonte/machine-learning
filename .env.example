environment=local

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=pgpc_lib_db_dev
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Optional separate PostgreSQL database for the large semantic search index.
# Blank values reuse the DB_* settings above.
ML_INDEX_DB_HOST=
ML_INDEX_DB_PORT=
ML_INDEX_DB_DATABASE=
ML_INDEX_DB_USERNAME=
ML_INDEX_DB_PASSWORD=

# Required for every /api/* request.
API_KEY="generate-a-long-random-secret"

# API protection.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=16384
REQUEST_TIMEOUT_SECONDS=30

# Scheduled training is disabled unless explicitly enabled.
AUTO_TRAIN_ENABLED=false
AUTO_TRAIN_TIME=00:00
AUTO_TRAIN_TIMEZONE=UTC

# Set true only for local/demo model training that needs generated interactions.
ML_INCLUDE_SEEDED_DATA=false
