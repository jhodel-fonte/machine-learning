environment=local

DB_CONNECTION=pgsql
DB_HOST=localhost
# Hostname used only when running inside Docker.
DB_HOST_CONTAINER=host.docker.internal
DB_PORT=5432
DB_DATABASE=pgpc_lib_db_dev
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Required for every /api/* request.
API_KEY="generate-a-long-random-secret"

# API protection.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=16384
REQUEST_TIMEOUT_SECONDS=30

# Scheduled training is disabled unless explicitly enabled.
AUTO_TRAIN_ENABLED=false
AUTO_TRAIN_TIME=00:00
AUTO_TRAIN_TIMEZONE=UTC
